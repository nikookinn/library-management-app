<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        Intentionally empty. Add an entry here only for a specific, reviewed false positive or an accepted
        risk, and always include a <notes> element explaining why the suppression is safe. Never suppress a
        finding just to make the pipeline pass without review.

        Example:
        <suppress>
            <notes><![CDATA[
            False positive: matches an unrelated product with the same name/version pattern.
            Reviewed 2026-08-25, ticket LIB-123.
            ]]></notes>
            <packageUrl regex="true">^pkg:maven/some\.group/some-artifact@.*$</packageUrl>
            <cve>CVE-0000-00000</cve>
        </suppress>
    -->
</suppressions>
